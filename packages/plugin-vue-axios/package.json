{
  "name": "@mundoit-lib/plugin-vue-axios",
  "version": "2.0.0",
  "description": "Vue 3 plugin for a shared Axios instance (JSON headers, multi-database base URL, infrastructure error hook). Internal use at Mundo IT; published on npm for easier distribution. Not recommended for external use.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-axios"
  },
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-axios#readme",
  "author": "@mundoit-lib",
  "keywords": ["vue", "vue3", "axios", "plugin", "vue-plugin", "http", "internal"],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "license": "MIT",
  "peerDependencies": {
    "axios": "^1.6.0",
    "vue": "^3.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
