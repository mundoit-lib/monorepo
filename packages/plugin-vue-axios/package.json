{
  "name": "@mundoit-lib/plugin-vue-axios",
  "version": "2.1.0",
  "description": "Vue 3 plugin for a shared Axios instance (JSON headers, multi-database base URL, infrastructure error hook). Internal use at Mundo IT; published on npm for easier distribution. Not recommended for external use.",
  "keywords": [
    "axios",
    "http",
    "internal",
    "plugin",
    "vue",
    "vue-plugin",
    "vue3"
  ],
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-axios#readme",
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "license": "MIT",
  "author": "@mundoit-lib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-axios"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint && attw --pack . --profile node16",
    "size": "size-limit"
  },
  "devDependencies": {
    "@mundoit-lib/tsconfig": "workspace:*",
    "@mundoit-lib/tsdown-config": "workspace:*"
  },
  "peerDependencies": {
    "axios": "catalog:peers",
    "vue": "catalog:peers"
  },
  "size-limit": [
    {
      "name": "ESM (gzip)",
      "path": "dist/index.js",
      "limit": "2 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "axios"
      ]
    }
  ]
}
