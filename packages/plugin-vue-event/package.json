{
  "name": "@mundoit-lib/plugin-vue-event",
  "version": "2.0.3",
  "description": "Plugin de Vue 3 con un bus de eventos global basado en mitt: $events, la opción de componente events: y useEvents() con auto-desregistro, con eventos tipados por module augmentation.",
  "keywords": [
    "custom-events",
    "event-bus",
    "event-system",
    "events",
    "frontend",
    "javascript",
    "vue",
    "vue-events",
    "vue-global-events",
    "vue-library",
    "vue-plugin",
    "vue-plugin-event-bus",
    "vue-plugin-events",
    "vue3"
  ],
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-event#readme",
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "license": "MIT",
  "author": "@mundoit-lib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-event"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./eventBus": {
      "import": {
        "types": "./dist/eventBus.d.ts",
        "default": "./dist/eventBus.js"
      },
      "require": {
        "types": "./dist/eventBus.d.cts",
        "default": "./dist/eventBus.cjs"
      }
    },
    "./useEvents": {
      "import": {
        "types": "./dist/useEvents.d.ts",
        "default": "./dist/useEvents.js"
      },
      "require": {
        "types": "./dist/useEvents.d.cts",
        "default": "./dist/useEvents.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint && attw --pack . --profile node16",
    "size": "size-limit"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@mundoit-lib/tsconfig": "workspace:*",
    "@mundoit-lib/tsdown-config": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:peers"
  },
  "size-limit": [
    {
      "name": "ESM index + subpaths (gzip)",
      "path": "dist/index.js",
      "limit": "1.5 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "mitt"
      ]
    }
  ]
}
