{
  "name": "@mundoit-lib/plugin-vue-event",
  "version": "2.0.0",
  "description": "Plugin de Vue 3 con un bus de eventos global basado en mitt: $events, la opción de componente events: y useEvents() con auto-desregistro, con eventos tipados por module augmentation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./eventBus": {
      "types": "./dist/eventBus.d.ts",
      "import": "./dist/eventBus.js",
      "require": "./dist/eventBus.cjs"
    },
    "./useEvents": {
      "types": "./dist/useEvents.d.ts",
      "import": "./dist/useEvents.js",
      "require": "./dist/useEvents.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-event"
  },
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-event#readme",
  "keywords": [
    "vue",
    "vue3",
    "vue-plugin",
    "events",
    "event-bus",
    "custom-events",
    "vue-global-events",
    "vue-plugin-event-bus",
    "vue-plugin-events",
    "vue-events",
    "javascript",
    "event-system",
    "frontend",
    "vue-library"
  ],
  "author": "@mundoit-lib",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
