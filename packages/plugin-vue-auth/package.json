{
  "name": "@mundoit-lib/plugin-vue-auth",
  "version": "1.0.5",
  "description": "Vue plugin for authentication integration using @websanova/vue-auth. Designed to centralize authentication logic and streamline user session management for internal projects. Although intended for internal use, it is publicly available on npm for easier distribution. Not recommended for external use.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-auth"
  },
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-auth#readme",
  "author": "@mundoit-lib",
  "keywords": ["vue", "auth", "plugin", "vue-plugin", "internal"],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "license": "MIT",
  "dependencies": {
    "@websanova/vue-auth": "4.2.1",
    "vue-demi": "0.14.10"
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.0.0-rc.1",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
