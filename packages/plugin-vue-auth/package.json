{
  "name": "@mundoit-lib/plugin-vue-auth",
  "version": "2.0.0",
  "description": "Vue 3 plugin for authentication (OAuth password grant, token refresh, $auth/useAuth) for Mundo IT apps. Although intended for internal use, it is publicly available on npm for easier distribution. Not recommended for external use.",
  "keywords": [
    "auth",
    "internal",
    "plugin",
    "vue",
    "vue-plugin"
  ],
  "homepage": "https://github.com/mundoit-lib/monorepo/tree/main/packages/plugin-vue-auth#readme",
  "bugs": {
    "url": "https://github.com/mundoit-lib/monorepo/issues"
  },
  "license": "MIT",
  "author": "@mundoit-lib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundoit-lib/monorepo.git",
    "directory": "packages/plugin-vue-auth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}
