{
  "name": "@mundoit-lib/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de las librerías frontend de Mundo IT (@mundoit-lib/*)",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && oxfmt --check && sherif",
    "lint:fix": "oxlint --fix && oxfmt --write && sherif --fix",
    "check:exports": "turbo run check:exports",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "axios": "^1.20.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "publint": "^0.3.24",
    "sherif": "^1.13.0",
    "tsup": "^8.5.1",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
