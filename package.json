{
  "name": "@mundoit-lib/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de las librerías frontend de Mundo IT (@mundoit-lib/*)",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --filter './packages/**' exec tsc --noEmit -p tsconfig.json",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "axios": "^1.20.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.43"
  }
}
